<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:FTMS_Viewer.Pages"
             x:Class="FTMS_Viewer.Pages.StatePage"
             x:DataType="l:StateViewModel"
             Title="State">
	<Grid RowDefinitions="Auto,*">
		<VerticalStackLayout Grid.Row="0" Spacing="10" Margin="10">
			<Border StrokeThickness="2" StrokeShape="RoundRectangle 10,10,10,10" Padding="10">
				<VerticalStackLayout Spacing="4">
					<Label Text="{Binding Status}"
						   FontSize="32"
						   FontAttributes="Bold"
						   HorizontalTextAlignment="Center"
						   VerticalTextAlignment="Center" />
					<Label Text="{Binding CurrentDetails}"
						   FontSize="16"
						   HorizontalTextAlignment="Center"
						   IsVisible="{Binding IsDetailsVisible}" />
					<VerticalStackLayout Spacing="2"
										 BindableLayout.ItemsSource="{Binding TrainingStateHistory}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="l:TrainingStateTileItem">
								<Label Text="{Binding StateName}"
									   Opacity="{Binding Opacity}"
									   FontSize="18"
									   FontAttributes="Bold"
									   HorizontalTextAlignment="Center" />
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>
			<Border StrokeThickness="2" StrokeShape="RoundRectangle 10,10,10,10" Padding="10">
				<VerticalStackLayout Spacing="2">
					<Label Text="Current Targets"
						   FontSize="18"
						   FontAttributes="Bold"
						   HorizontalTextAlignment="Center" />
					<VerticalStackLayout Spacing="1"
										 BindableLayout.ItemsSource="{Binding CurrentTargets}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="l:CurrentTargetItem">
								<Grid ColumnDefinitions="*,Auto">
									<Label Grid.Column="0"
										   Text="{Binding Name}"
										   FontSize="13"
										   VerticalOptions="Center" />
									<Label Grid.Column="1"
										   Text="{Binding DisplayValue}"
										   FontSize="13"
										   HorizontalTextAlignment="End"
										   VerticalOptions="Center" />
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>
		</VerticalStackLayout>
		<CollectionView Grid.Row="1" Margin="10" x:Name="MachineStateLogCollectionView"
						ItemsSource="{Binding MachineStateLog}"
						SelectionMode="None">
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="l:MachineStateLogItem">
					<Border StrokeThickness="2" StrokeShape="RoundRectangle 10,10,10,10" Padding="8" Margin="0,2">
						<VerticalStackLayout Spacing="2">
							<Label Text="{Binding OpCodeName}"
								   FontSize="16"
								   FontAttributes="Bold" />
							<Label Text="{Binding Parameters}"
								   FontSize="13"
								   IsVisible="{Binding HasParameters}" />
							<Label Text="{Binding RawData}"
								   FontSize="11"
								   Opacity="0.6" />
						</VerticalStackLayout>
					</Border>
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
	</Grid>
</ContentPage>
