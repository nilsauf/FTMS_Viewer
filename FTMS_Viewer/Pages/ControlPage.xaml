<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FTMS_Viewer.Pages.ControlPage"
			 xmlns:l="clr-namespace:FTMS_Viewer.Pages"
			 x:DataType="l:ControlViewModel"
             Title="Control">

	<ContentPage.Resources>
		<Style TargetType="Button">
			<Setter Property="HeightRequest" Value="60" />
			<Setter Property="FontSize" Value="18" />
			<Setter Property="CornerRadius" Value="12" />
		</Style>

		<DataTemplate x:Key="ControlOperationTemplate"
					  x:DataType="l:ControlOperationItem">
			<Button Text="{Binding Name}"
					Command="{Binding Command}" />
		</DataTemplate>

		<DataTemplate x:Key="TargetValueTemplate"
					  x:DataType="l:TargetValueItem">
			<Border Stroke="Gray"
					StrokeThickness="1"
					StrokeShape="RoundRectangle 10,10,10,10"
					Padding="12">
				<VerticalStackLayout Spacing="8">
					<HorizontalStackLayout Spacing="8">
						<Label Text="{Binding Name}"
							   FontSize="16"
							   FontAttributes="Bold"
							   VerticalOptions="Center" />
						<Label Text="{Binding Unit}"
							   FontSize="14"
							   Opacity="0.6"
							   VerticalOptions="Center" />
						<Label Text="advertised as not supported"
							   FontSize="12"
							   TextColor="DarkOrange"
							   VerticalOptions="Center"
							   IsVisible="{Binding IsNotSupported}" />
					</HorizontalStackLayout>
					<HorizontalStackLayout Spacing="8">
						<Entry Text="{Binding Value}"
							   FontSize="16"
							   WidthRequest="140"
							   Placeholder="{Binding Name}"
							   TextChanged="OnTargetValueTextChanged" />
						<Button Text="Send"
								Command="{Binding Command}"
								FontSize="16"
								HeightRequest="44" />
					</HorizontalStackLayout>
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<DataTemplate x:Key="MultiValueTargetTemplate"
					  x:DataType="l:MultiValueTargetItem">
			<Border Stroke="Gray"
					StrokeThickness="1"
					StrokeShape="RoundRectangle 10,10,10,10"
					Padding="12">
				<VerticalStackLayout Spacing="8">
					<HorizontalStackLayout Spacing="8">
						<Label Text="{Binding Name}"
							   FontSize="16"
							   FontAttributes="Bold"
							   VerticalOptions="Center" />
						<Label Text="{Binding Unit}"
							   FontSize="14"
							   Opacity="0.6"
							   VerticalOptions="Center" />
						<Label Text="advertised as not supported"
							   FontSize="12"
							   TextColor="DarkOrange"
							   VerticalOptions="Center"
							   IsVisible="{Binding IsNotSupported}" />
					</HorizontalStackLayout>
					<VerticalStackLayout Spacing="4"
										 BindableLayout.ItemsSource="{Binding Entries}">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="l:MultiValueTargetEntry">
								<HorizontalStackLayout Spacing="8">
									<Label Text="{Binding Label}"
										   FontSize="14"
										   WidthRequest="110"
										   VerticalOptions="Center" />
									<Entry Text="{Binding Value}"
										   FontSize="16"
										   WidthRequest="140"
										   Placeholder="{Binding Label}" />
								</HorizontalStackLayout>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
					<Button Text="Send"
							Command="{Binding Command}"
							FontSize="16"
							HeightRequest="44" />
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<l:ControlItemTemplateSelector x:Key="ControlItemTemplateSelector"
									   OperationTemplate="{StaticResource ControlOperationTemplate}"
									   ValueTemplate="{StaticResource TargetValueTemplate}"
									   MultiValueTemplate="{StaticResource MultiValueTargetTemplate}" />
	</ContentPage.Resources>

	<Grid RowDefinitions="Auto,Auto,*">
		<Border Grid.Row="0"
				StrokeThickness="2"
				StrokeShape="RoundRectangle 10,10,10,10"
				Padding="10"
				Margin="10">
			<VerticalStackLayout Spacing="2">
				<Label Text="Control Permission"
					   FontSize="14"
					   Opacity="0.7"
					   HorizontalTextAlignment="Center" />
				<Label Text="{Binding PermissionText}"
					   TextColor="{Binding PermissionColor}"
					   FontSize="24"
					   FontAttributes="Bold"
					   HorizontalTextAlignment="Center" />
			</VerticalStackLayout>
		</Border>
		<Border Grid.Row="1"
				StrokeThickness="2"
				StrokeShape="RoundRectangle 10,10,10,10"
				Padding="10"
				Margin="10,0,10,10">
			<VerticalStackLayout Spacing="6">
				<Label Text="{Binding Status}"
					   FontSize="16"
					   HorizontalTextAlignment="Center" />
				<HorizontalStackLayout HorizontalOptions="Center"
									   Spacing="10">
					<Label Text="Allow out of range"
						   FontSize="14"
						   VerticalOptions="Center" />
					<Switch IsToggled="{Binding IsAllowOutOfRange}" />
				</HorizontalStackLayout>
			</VerticalStackLayout>
		</Border>
		<ScrollView Grid.Row="2">
			<VerticalStackLayout Spacing="16"
								 Margin="20"
								 BindableLayout.ItemsSource="{Binding ControlGroups}">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="l:ControlGroupViewModel">
						<VerticalStackLayout Spacing="8">
							<Label Text="{Binding Title}"
								   FontSize="22"
								   FontAttributes="Bold" />
							<VerticalStackLayout Spacing="8"
												 BindableLayout.ItemsSource="{Binding Items}"
												 BindableLayout.ItemTemplateSelector="{StaticResource ControlItemTemplateSelector}" />
						</VerticalStackLayout>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>
		</ScrollView>
	</Grid>

</ContentPage>
