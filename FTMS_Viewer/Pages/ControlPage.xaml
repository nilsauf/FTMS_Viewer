<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FTMS_Viewer.Pages.ControlPage"
			 xmlns:l="clr-namespace:FTMS_Viewer.Pages"
			 x:DataType="l:ControlViewModel"
             Title="Control">

	<ContentPage.Resources>
		<Style TargetType="Button">
			<Setter Property="HeightRequest" Value="60" />
			<Setter Property="FontSize" Value="18" />
			<Setter Property="CornerRadius" Value="12" />
		</Style>
	</ContentPage.Resources>

	<Grid RowDefinitions="Auto,Auto,*">
		<Border Grid.Row="0"
				StrokeThickness="2"
				StrokeShape="RoundRectangle 10,10,10,10"
				Padding="10"
				Margin="10">
			<VerticalStackLayout Spacing="2">
				<Label Text="Control Permission"
					   FontSize="14"
					   Opacity="0.7"
					   HorizontalTextAlignment="Center" />
				<Label Text="{Binding PermissionText}"
					   TextColor="{Binding PermissionColor}"
					   FontSize="24"
					   FontAttributes="Bold"
					   HorizontalTextAlignment="Center" />
			</VerticalStackLayout>
		</Border>
		<Border Grid.Row="1"
				StrokeThickness="2"
				StrokeShape="RoundRectangle 10,10,10,10"
				Padding="10"
				Margin="10,0,10,10">
			<Label Text="{Binding Status}"
				   FontSize="16"
				   HorizontalTextAlignment="Center" />
		</Border>
		<ScrollView Grid.Row="2">
			<VerticalStackLayout Spacing="16"
								 Margin="20"
								 BindableLayout.ItemsSource="{Binding ControlGroups}">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="l:ControlGroupViewModel">
						<VerticalStackLayout Spacing="8">
							<Label Text="{Binding Title}"
								   FontSize="22"
								   FontAttributes="Bold" />
							<VerticalStackLayout Spacing="8"
												 BindableLayout.ItemsSource="{Binding Items}">
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="l:ControlItemViewModel">
										<Button Text="{Binding Name}"
												Command="{Binding Command}" />
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>
						</VerticalStackLayout>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>
		</ScrollView>
	</Grid>

</ContentPage>
